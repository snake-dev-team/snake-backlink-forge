# Snake Backlink Forge — apps/landing public env vars (NEXT_PUBLIC_* bundled into client JS).
# Copy to .env.local for local dev. Vercel sets these per environment in dashboard.
# All vars validated by apps/landing/src/lib/env.ts at boot — fail-loud on missing required.

# === Required (boot fails if missing) ===

# Phase 2 backend API (currently live on Fly.io)
NEXT_PUBLIC_API_BASE_URL=https://snake-backlink-api.fly.dev

# This app's public URL (Vercel auto-assigned subdomain Phase 3-10; custom domain Phase 11)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram bot username (no @ prefix) — used for deep-link login redirect
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=SnakeBacklinkForgeBot

# Sentry DSN for FE error tracking (Phase 7 wires withSentryConfig)
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@oXXX.ingest.sentry.io/YYY

# Plausible analytics domain (cookieless, Phase 7)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=snakebacklink.com

# === Optional (auto-set by Vercel — do NOT set manually) ===

# NEXT_PUBLIC_VERCEL_URL=  # Vercel previews auto-populate; used for Origin allowlist fallback (RT-R2 F5)

# === Server-only (NO NEXT_PUBLIC_ prefix — set in Vercel dashboard for prod) ===

# SENTRY_AUTH_TOKEN=         # Phase 7 sourcemap upload
# SENTRY_ORG=                # Phase 7 — sentry org slug
# SENTRY_PROJECT=sbf-web     # Phase 7 — sentry project slug
