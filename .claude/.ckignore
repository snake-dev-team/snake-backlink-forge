# ClaudeKit Ignore File - SIZE-based blocking
# Blocks directories with heavy file counts that fill LLM context
# Syntax: gitignore-spec | Use ! prefix to allow (e.g., !src/vendor)

# JS/TS
node_modules
dist
build
.next
.nuxt

# Python
__pycache__
.venv
venv

# Go/PHP/Rust/Java
vendor
target

# VCS & Coverage
.git
coverage

# Allow reading these files
!.env
!.env.*

# Allow ClaudeKit hook internals (vendor shim + npm deps for scout-block)
!.claude/hooks/node_modules
!.claude/hooks/node_modules/**
!.claude/hooks/scout-block/vendor
!.claude/hooks/scout-block/vendor/**