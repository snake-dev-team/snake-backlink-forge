# ── Snake Backlink Forge — API Service Environment Variables ──────────────────
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git — it is listed in .gitignore.
# Production (Fly.io): set secrets via `fly secrets set KEY=value`.

# ── Required ──────────────────────────────────────────────────────────────────
# Local: sslmode=disable  |  Fly Postgres: sslmode=require
DATABASE_URL=postgres://sbf:sbf@localhost:5432/sbf_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ── Claude via 9Router (Phase 2) ──────────────────────────────────────────────
CLAUDE_BASE_URL=https://r7yyfje.9router.com
CLAUDE_MODEL=cc/claude-sonnet-4-6

# ── Telegram Bot + SePay Payments (Phase 2) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
SEPAY_WEBHOOK_TOKEN=

# ── SePay QR + Webhook (Phase 05-06) ──────────────────────────────────────────
# Bank identifier used in QR URL generation (SePay bank code, e.g. MBBank, VCB, TCB).
SEPAY_BANK_CODE=MBBank
# Destination bank account number for VND transfers. Never commit real values.
SEPAY_BANK_ACCOUNT=

# ── External APIs (Phase 4–6) ─────────────────────────────────────────────────
SERPAPI_KEY=
MOZ_ACCESS_ID=
MOZ_SECRET=
TWOCAPTCHA_MASTER_KEY=
CAPSOLVER_MASTER_KEY=
RESEND_KEY=

# ── Auth (Phase 3) ────────────────────────────────────────────────────────────
JWT_SECRET=
# Comma-separated list of Telegram user IDs with admin access, e.g. 123456,789012
ADMIN_TELEGRAM_IDS=

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=8080
ENV=development
